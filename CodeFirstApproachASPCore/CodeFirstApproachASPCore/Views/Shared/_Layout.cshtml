<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CodeFirstApproachASPCore</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CodeFirstApproachASPCore.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
</head>
<body class="bg-black text-white">

    <header>
        <nav class="bg-black text-white border-b shadow mb-3">
            <div class="container mx-auto flex justify-between items-center">
                <!-- Centered Name -->
                <a class="text-lg font-bold text-white mx-auto tracking-widest hover:text-gray-400 transition duration-300"
                   asp-area="" asp-controller="Home" asp-action="Index">
                    CRUD APP USING CODEFIRST
                </a>
                <!-- Menu Button for Mobile -->
                <button class="md:hidden p-2 text-white" type="button" aria-label="Toggle navigation">
                    <span class="material-icons">menu</span>
                </button>
                <!-- Menu Items -->
                <div class="navbar-collapse collapse md:flex md:items-center md:w-auto w-full">
                    <ul class="flex flex-col md:flex-row items-center space-x-4">
                        <li class="nav-item">
                            <a class="text-white hover:text-gray-400 transition duration-300" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="text-white hover:text-gray-400 transition duration-300" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mx-auto">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-t text-gray-500 py-4">
        <div class="container mx-auto text-center">
            &copy; 2024 - CRUD APP USING CODEFIRST -
            <a class="text-gray-700 hover:text-gray-500 transition duration-300" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <!-- Icons and JS libraries -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/js/all.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
