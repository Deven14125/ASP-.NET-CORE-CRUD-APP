@model CodeFirstApproachASPCore.Models.Student

@{
    ViewData["Title"] = "Delete";
}

<h1 class="text-center text-5xl font-extrabold text-red-600 mb-6">Delete Student Record</h1>

<h3 class="text-center text-xl text-yellow-500 font-semibold mb-6">Are you sure you want to delete this student?</h3>

<div class="max-w-3xl mx-auto">
    <div class="card border-t-4 border-red-500 shadow-xl bg-gradient-to-r from-red-500 via-orange-500 to-yellow-500 rounded-lg overflow-hidden">
        <div class="card-body p-8">
            <h4 class="text-2xl font-semibold text-white text-center mb-6">Student Details</h4>
            <hr class="border-t-2 border-white mb-6" />

            <dl class="grid grid-cols-1 md:grid-cols-2 gap-6 text-gray-800">
                <dt class="font-semibold text-lg text-white">Name:</dt>
                <dd class="text-lg text-gray-800">
                    <span class="bg-white px-4 py-2 rounded-md shadow-sm">@Html.DisplayFor(model => model.Name)</span>
                </dd>

                <dt class="font-semibold text-lg text-white">Gender:</dt>
                <dd class="text-lg text-gray-800">
                    <span class="bg-white px-4 py-2 rounded-md shadow-sm">@Html.DisplayFor(model => model.Gender)</span>
                </dd>

                <dt class="font-semibold text-lg text-white">Roll No:</dt>
                <dd class="text-lg text-gray-800">
                    <span class="bg-white px-4 py-2 rounded-md shadow-sm">@Html.DisplayFor(model => model.RollNo)</span>
                </dd>

                <dt class="font-semibold text-lg text-white">Standard:</dt>
                <dd class="text-lg text-gray-800">
                    <span class="bg-white px-4 py-2 rounded-md shadow-sm">@Html.DisplayFor(model => model.Standard)</span>
                </dd>
            </dl>

            <div class="text-center mt-8">
                <form asp-action="Delete" class="inline-block">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="w-48 bg-red-600 text-white py-4 rounded-lg shadow-md hover:bg-red-700 transform transition-all duration-300 hover:scale-105 mx-2">Delete</button>
                </form>
                <a asp-action="Index" class="w-48 bg-gray-600 text-white py-4 rounded-lg shadow-md hover:bg-gray-700 transform transition-all duration-300 hover:scale-105 mx-2">Back to List</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
