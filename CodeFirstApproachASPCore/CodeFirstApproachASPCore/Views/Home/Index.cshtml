@model IEnumerable<CodeFirstApproachASPCore.Models.Student>

@{
    ViewData["Title"] = "Index";
}

<h1 class="text-center text-4xl text-blue-400 font-bold mb-8">Student List</h1>

<p class="text-center">
    <a asp-action="Create" class="bg-green-600 text-white py-3 px-6 rounded-lg shadow-lg hover:bg-green-700 transition duration-300">Create New Student</a>
</p>

@{
    if (TempData["insert_success"] != null)
    {
        <div id="success-alert" class="bg-green-200 border border-green-500 text-green-800 px-4 py-3 rounded-lg shadow-lg relative mb-4 transition-opacity duration-500 ease-in-out">
            <strong>Success! </strong>@TempData["insert_success"]
        </div>
    }
    if (TempData["edit_success"] != null)
    {
        <div id="edit-alert" class="bg-yellow-200 border border-yellow-500 text-yellow-800 px-4 py-3 rounded-lg shadow-lg relative mb-4 transition-opacity duration-500 ease-in-out">
            <strong>Updated! </strong>@TempData["edit_success"]
        </div>
    }
    if (TempData["delete_success"] != null)
    {
        <div id="delete-alert" class="bg-red-200 border border-red-500 text-red-800 px-4 py-3 rounded-lg shadow-lg relative mb-4 transition-opacity duration-500 ease-in-out">
            <strong>Deleted! </strong>@TempData["delete_success"]
        </div>
    }
}

<div class="overflow-x-auto mt-8">
    <table class="min-w-full bg-gradient-to-r from-gray-900 via-gray-800 to-gray-700 text-white rounded-lg shadow-lg">
        <thead>
            <tr class="bg-gradient-to-r from-red-500 via-rose-400 to-green-500 text-white">
                <th class="py-3 px-4 text-left">ID</th>
                <th class="py-3 px-4 text-left">Name</th>
                <th class="py-3 px-4 text-left">Gender</th>
                <th class="py-3 px-4 text-center">Actions</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-700">
            @foreach (var item in Model)
            {
                <tr class="hover:bg-gradient-to-r from-gray-700 to-rose-600 bg-hover-violet-500 hover:shadow-xl transition duration-300 ease-in-out">
                    <td class="py-3 px-4">@Html.DisplayFor(modelItem => item.Id)</td>
                    <td class="py-3 px-4">@Html.DisplayFor(modelItem => item.Name)</td>
                    <td class="py-3 px-4">@Html.DisplayFor(modelItem => item.Gender)</td>
                    <td class="py-3 px-4 text-center">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="text-yellow-500 mx-2 text-xl hover:text-yellow-600 transition duration-300">
                            <i class="fas fa-edit"></i>
                        </a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="text-blue-500 mx-2 text-xl hover:text-blue-600 transition duration-300">
                            <i class="fas fa-info-circle"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="text-red-500 mx-2 text-xl hover:text-red-600 transition duration-300">
                            <i class="fas fa-trash-alt"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
    // Hide alerts after 2 seconds
    setTimeout(function () {
        const successAlert = document.getElementById('success-alert');
        const editAlert = document.getElementById('edit-alert');
        const deleteAlert = document.getElementById('delete-alert');

        if (successAlert) successAlert.style.opacity = '0';
        if (editAlert) editAlert.style.opacity = '0';
        if (deleteAlert) deleteAlert.style.opacity = '0';
    }, 2000);
</script>
