@model CodeFirstApproachASPCore.Models.Student

@{
    ViewData["Title"] = "Edit";
}

<h1 class="text-center text-4xl font-extrabold text-purple-600 mb-6">Edit Student</h1>

<h4 class="text-center text-xl text-emerald-500 font-medium mb-4">Update Student Information</h4>
<hr class="border-t-2 border-emerald-400 my-4" />

<div class="flex justify-center">
    <div class="w-full max-w-3xl">
        <div class="bg-black shadow-lg rounded-xl p-8">
            <form asp-action="Edit" class="space-y-6">
                <div asp-validation-summary="ModelOnly" class="text-red-500 mb-4"></div>
                <input type="hidden" asp-for="Id" />

                <!-- Roll No -->
                <div class="form-group mb-6">
                    <label asp-for="RollNo" class="block text-sm font-semibold text-gray-700 mb-2">Roll No</label>
                    <input asp-for="RollNo" class="form-control text-black w-full p-4 border-2 border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all duration-300" placeholder="Enter Roll No" />
                    <span asp-validation-for="RollNo" class="text-red-500 text-sm"></span>
                </div>

                <!-- Name -->
                <div class="form-group mb-6">
                    <label asp-for="Name" class="block text-sm font-semibold text-black-700 mb-2">Full Name</label>
                    <input asp-for="Name" class="form-control text-black w-full p-4 border-2 border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all duration-300" placeholder="Enter Full Name" />
                    <span asp-validation-for="Name" class="text-red-500 text-sm"></span>
                </div>

                <!-- Gender -->
                <div class="form-group mb-6">
                    <label asp-for="Gender" class="block text-sm font-semibold text-gray-700 mb-2">Gender</label>
                    <select asp-for="Gender" asp-items="@ViewBag.Gender" class="text-black form-control w-full p-4 border-2 border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all duration-300">
                        <option value="">Select Gender</option>
                    </select>
                    <span asp-validation-for="Gender" class="text-red-500 text-sm"></span>
                </div>

                <!-- Standard -->
                <div class="form-group mb-6">
                    <label asp-for="Standard" class="block text-sm font-semibold text-gray-700 mb-2">Standard</label>
                    <select asp-for="Standard" asp-items="@ViewBag.Standard" class="text-black form-control w-full p-4 border-2 border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all duration-300">
                        <option value="">Select Standard</option>
                    </select>
                    <span asp-validation-for="Standard" class="text-red-500 text-sm"></span>
                    @* <input asp-for="Standard" class="form-control text-black w-full p-4 border-2 border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-all duration-300" placeholder="Enter Standard" /> *@
                </div>

                <!-- Submit Button -->
                <div class="d-grid gap-2">
                    <button type="submit" class="w-full bg-emerald-500 text-white py-4 rounded-md shadow-md hover:bg-emerald-600 transform transition-all duration-300 hover:scale-105 focus:outline-none">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Back to List Button -->

<div class="mt-6 text-center">
    <a asp-action="Index" class="bg-gray-600 text-white px-6 py-3 rounded-md hover:bg-gray-700 transition duration-300">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
